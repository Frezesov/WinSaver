<Window x:Class="WinSaver.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinSaver.Controls"
        Title="WinSaver"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="720" Height="900" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding HideToTrayCommand}" />
    </Window.InputBindings>

    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1000">

            <!-- The last screenshot and the way to the editor -->
            <TextBlock Text="Скриншоты" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
            <controls:SettingsCard Glyph="&#xE722;" Title="Последний скриншот" Description="{Binding LastShotDetails}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Новый" MinWidth="96" Margin="0,0,8,0" Command="{Binding NewScreenshotCommand}"
                            AutomationProperties.Name="Сделать новый скриншот" />
                    <Button Style="{DynamicResource AccentButtonStyle}" MinWidth="120" Command="{Binding EditLastCommand}"
                            IsEnabled="{Binding HasLastShot}" AutomationProperties.Name="Редактировать последний скриншот">
                        <StackPanel Orientation="Horizontal">
                            <controls:Glyph Text="&#xE70F;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                            Margin="0,1,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Редактировать" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </controls:SettingsCard>

            <!-- Calling WinSaver -->
            <TextBlock Text="Вызов" Style="{StaticResource SectionTitle}" />

            <controls:SettingsCard Glyph="&#xE765;" Title="Заменить «Ножницы» на Win + Shift + S"
                                   Description="Win + Shift + S открывает WinSaver вместо «Ножниц» Windows. Если выключить, сочетание снова будет открывать «Ножницы»">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ReplaceSnipping}" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE7F4;" Title="Клавиша Print Screen"
                                   Description="Print Screen тоже открывает WinSaver. Alt + Print Screen и другие сочетания работают как раньше">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding InterceptPrintScreen}" />
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE92E;" Title="Своё сочетание клавиш"
                                   Description="Ещё одно сочетание для нового скриншота. Нажмите на поле и введите его. Esc — отмена, Backspace — очистить">
                <controls:SettingsCard.Detail>
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding HotkeyError}" />
                </controls:SettingsCard.Detail>
                <controls:HotkeyBox Hotkey="{Binding Hotkey}"
                                    IsCapturing="{Binding IsCapturingHotkey, Mode=OneWayToSource}"
                                    AutomationProperties.Name="Своё сочетание клавиш для нового скриншота" />
            </controls:SettingsCard>

            <!-- Saving -->
            <TextBlock Text="Сохранение" Style="{StaticResource SectionTitle}" />

            <controls:SettingsCard Glyph="&#xE838;" Title="Папка для скриншотов" Description="{Binding SaveFolder}">
                <controls:SettingsCard.Detail>
                    <TextBlock Style="{StaticResource RowDescription}" Margin="0,6,0,0"
                               Text="Файлы называются по времени снимка: Screenshot 2026-09-27 14-32-05.png" />
                </controls:SettingsCard.Detail>
                <StackPanel Orientation="Horizontal">
                    <Button Content="По умолчанию" Margin="0,0,8,0" Command="{Binding ResetFolderCommand}"
                            Visibility="{Binding IsDefaultFolder, Converter={StaticResource InverseBoolToVisibility}}"
                            AutomationProperties.Name="Вернуть папку по умолчанию" />
                    <Button Content="Открыть" Margin="0,0,8,0" Command="{Binding OpenFolderCommand}"
                            AutomationProperties.Name="Открыть папку со скриншотами" />
                    <Button Content="Изменить…" Click="OnChangeFolder" AutomationProperties.Name="Выбрать другую папку для скриншотов" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard Glyph="&#xE74D;" Title="Удалять старые скриншоты"
                                   Description="Удаляются только файлы WinSaver (Screenshot …png) прямо в этой папке. Остальные файлы и вложенные папки не трогаются">
                <ComboBox MinWidth="170" ItemsSource="{Binding KeepOptions}" DisplayMemberPath="Label" SelectedValuePath="Days"
                          SelectedValue="{Binding KeepDays}" AutomationProperties.Name="Когда удалять старые скриншоты" />
            </controls:SettingsCard>

            <!-- System -->
            <TextBlock Text="Система" Style="{StaticResource SectionTitle}" />

            <controls:SettingsCard Glyph="&#xE7E8;" Title="Запускать вместе с Windows"
                                   Description="Программа стартует свёрнутой в трей. Закрытое окно тоже прячется в трей — управление правой кнопкой по значку">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Autostart}" />
            </controls:SettingsCard>

            <controls:SettingsExpander Glyph="&#xE946;" Title="О программе" Description="{Binding VersionText}">
                <controls:SettingsExpander.HeaderContent>
                    <Border Style="{StaticResource Badge}" Margin="0"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource BadgeText}" Text="доступно обновление"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                </controls:SettingsExpander.HeaderContent>
                <StackPanel>
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="{Binding UpdateTitle}" Description="{Binding UpdateDetail}">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding DownloadUpdateCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0"
                                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.Name="{Binding DownloadUpdateText}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DownloadUpdateText}" />
                                    <controls:Glyph Text="&#xE8A7;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                                    Margin="8,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Content="Проверить" MinWidth="96" Command="{Binding CheckUpdatesCommand}"
                                    IsEnabled="{Binding CanCheckUpdates}" AutomationProperties.Name="Проверить обновления" />
                        </StackPanel>
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Проверять обновления автоматически"
                                           Description="Раз в сутки программа спрашивает у GitHub, вышла ли новая версия. Сама ничего не скачивает">
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CheckForUpdates}" />
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Страница проекта"
                                           Description="Исходный код, новые версии и описание на GitHub">
                        <Button Command="{Binding OpenProjectPageCommand}" AutomationProperties.Name="Открыть страницу проекта на GitHub">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GitHub" />
                                <controls:Glyph Text="&#xE8A7;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"
                                                Margin="8,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </controls:SettingsCard>
                    <Border Style="{StaticResource Divider}" />
                    <controls:SettingsCard Style="{StaticResource SettingsRow}" Title="Выйти из программы"
                                           Description="Win + Shift + S снова будет открывать «Ножницы» до следующего запуска WinSaver">
                        <Button Content="Выйти" MinWidth="96" Command="{Binding ExitCommand}"
                                AutomationProperties.Name="Выйти из программы" />
                    </controls:SettingsCard>
                </StackPanel>
            </controls:SettingsExpander>
        </StackPanel>
    </controls:SmoothScrollViewer>
</Window>
