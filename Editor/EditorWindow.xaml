<Window x:Class="WinSaver.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinSaver.Controls"
        xmlns:editor="clr-namespace:WinSaver.Editor"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1000" Height="720" MinWidth="880" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Commands: undo/redo and zoom on the left, results on the right -->
        <Grid Margin="12,8,12,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" FontSize="16"
                        Width="36" Height="36" Click="OnUndo"
                        ToolTip="Отменить (Ctrl + Z)" AutomationProperties.Name="Отменить" />
                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" FontSize="16"
                        Width="36" Height="36" Click="OnRedo"
                        ToolTip="Повторить (Ctrl + Y)" AutomationProperties.Name="Повторить" />
                <TextBlock x:Name="ZoomText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="Ctrl + колесо — масштаб, Ctrl + 0 — вписать в окно, пробел или средняя кнопка — двигать" />
                <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="OnCopy" Margin="0,0,8,0" ToolTip="Ctrl + C" AutomationProperties.Name="Копировать в буфер обмена">
                    <StackPanel Orientation="Horizontal">
                        <controls:Glyph Text="&#xE8C8;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                        Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Копировать" />
                    </StackPanel>
                </Button>
                <Button Click="OnSaveAs" Margin="0,0,8,0" ToolTip="Ctrl + Shift + S" AutomationProperties.Name="Сохранить как">
                    <StackPanel Orientation="Horizontal">
                        <controls:Glyph Text="&#xE792;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                        Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Сохранить как…" />
                    </StackPanel>
                </Button>
                <Button Click="OnDone" Style="{DynamicResource AccentButtonStyle}" MinWidth="104"
                        ToolTip="Сохранить скриншот, скопировать и закрыть (Ctrl + S)" AutomationProperties.Name="Готово">
                    <StackPanel Orientation="Horizontal">
                        <controls:Glyph Text="&#xE8FB;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                        Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Готово" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <editor:EditorCanvas x:Name="Board" Grid.Row="1" />

        <!-- Tools, colours and thickness, like the photo editor in Telegram -->
        <Border Grid.Row="2" Style="{StaticResource ToolBarPanel}" HorizontalAlignment="Center" Margin="12,4,12,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="ToolButtons" Orientation="Horizontal" />

                <StackPanel x:Name="StyleControls" Orientation="Horizontal">
                    <Border Style="{StaticResource ToolBarDivider}" />
                    <StackPanel x:Name="ColorButtons" Orientation="Horizontal" />
                    <Border Style="{StaticResource ToolBarDivider}" />
                    <Grid Width="28" Height="28" VerticalAlignment="Center" Margin="2,0,6,0">
                        <Ellipse x:Name="SizePreview" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                    </Grid>
                    <Slider x:Name="SizeSlider" Width="120" SmallChange="1" LargeChange="2"
                            Minimum="{x:Static editor:EditorTools.MinSize}" Maximum="{x:Static editor:EditorTools.MaxSize}"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,8,0"
                            AutomationProperties.Name="Толщина линии" ToolTip="Толщина" />
                </StackPanel>

                <StackPanel x:Name="CropButtons" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Style="{StaticResource ToolBarDivider}" />
                    <Button Content="Сбросить" Margin="0,0,8,0" Click="OnCropReset" AutomationProperties.Name="Сбросить обрезку" />
                    <Button Content="Отмена" Margin="0,0,8,0" Click="OnCropCancel" AutomationProperties.Name="Отменить обрезку" />
                    <Button Content="Применить" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,4,0" Click="OnCropApply"
                            AutomationProperties.Name="Применить обрезку" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
