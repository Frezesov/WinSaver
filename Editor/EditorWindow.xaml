<Window x:Class="WinSaver.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinSaver.Controls"
        xmlns:editor="clr-namespace:WinSaver.Editor"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1000" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="14"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Commands: undo/redo and zoom on the left, results on the right -->
        <Grid Margin="12,8,12,4">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" FontSize="16"
                        Width="36" Height="36" Click="OnUndo"
                        ToolTip="Отменить (Ctrl + Z)" AutomationProperties.Name="Отменить" />
                <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" FontSize="16"
                        Width="36" Height="36" Click="OnRedo"
                        ToolTip="Повторить (Ctrl + Y)" AutomationProperties.Name="Повторить" />
                <TextBlock x:Name="ZoomText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="Ctrl + колесо — масштаб, Ctrl + 0 — вписать в окно, пробел или средняя кнопка — двигать" />
                <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="OnCopy" Margin="0,0,8,0" ToolTip="Ctrl + C" AutomationProperties.Name="Копировать в буфер обмена">
                    <StackPanel Orientation="Horizontal">
                        <controls:Glyph Text="&#xE8C8;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                        Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Копировать" />
                    </StackPanel>
                </Button>
                <Button Click="OnSaveAs" Margin="0,0,8,0" ToolTip="Ctrl + Shift + S" AutomationProperties.Name="Сохранить как">
                    <StackPanel Orientation="Horizontal">
                        <controls:Glyph Text="&#xE792;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                        Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Сохранить как…" />
                    </StackPanel>
                </Button>
                <Button Click="OnDone" Style="{DynamicResource AccentButtonStyle}" MinWidth="104"
                        ToolTip="Сохранить скриншот, скопировать и закрыть (Ctrl + S)" AutomationProperties.Name="Готово">
                    <StackPanel Orientation="Horizontal">
                        <controls:Glyph Text="&#xE8FB;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"
                                        Margin="0,1,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Готово" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <editor:EditorCanvas x:Name="Board" Grid.Row="1" />

        <!-- Tools, colours and thickness, like the photo editor in Telegram -->
        <Border Grid.Row="2" Style="{StaticResource ToolBarPanel}" HorizontalAlignment="Center" Margin="12,4,12,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel x:Name="ToolButtons" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="{x:Static editor:EditorTool.Pen}"
                                 Content="&#xEDFB;" ToolTip="Перо (P)" AutomationProperties.Name="Перо" />
                    <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="{x:Static editor:EditorTool.Marker}"
                                 Content="&#xE7E6;" ToolTip="Маркер (M)" AutomationProperties.Name="Маркер" />
                    <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="{x:Static editor:EditorTool.Arrow}"
                                 Content="&#xE72A;" ToolTip="Стрелка (A). Рисуйте линию — наконечник появится сам, с Shift линия прямая"
                                 AutomationProperties.Name="Стрелка" />
                    <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="{x:Static editor:EditorTool.Rectangle}"
                                 Content="&#xE739;" ToolTip="Прямоугольник (R). С Shift — квадрат" AutomationProperties.Name="Прямоугольник" />
                    <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="{x:Static editor:EditorTool.Ellipse}"
                                 Content="&#xEA3A;" ToolTip="Овал (O). С Shift — круг" AutomationProperties.Name="Овал" />
                    <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="{x:Static editor:EditorTool.Text}"
                                 Content="&#xE8D2;" ToolTip="Текст (T). Enter — готово, Shift + Enter — новая строка"
                                 AutomationProperties.Name="Текст" />
                    <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="{x:Static editor:EditorTool.Pixelate}"
                                 ToolTip="Размытие (B). Скрывает личные данные мозаикой" AutomationProperties.Name="Размытие">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              Data="M1,1 H6 V6 H1 Z M11,1 H16 V6 H11 Z M6,6 H11 V11 H6 Z M1,11 H6 V16 H1 Z M11,11 H16 V16 H11 Z
                                    M0,0 H17 V17 H0 Z M1,1 V16 H16 V1 Z" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="{x:Static editor:EditorTool.Crop}"
                                 Content="&#xE7A8;" ToolTip="Обрезка (C). Enter — применить, Esc — отмена" AutomationProperties.Name="Обрезка" />
                    <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tool" Tag="{x:Static editor:EditorTool.Eraser}"
                                 Content="&#xE75C;" ToolTip="Ластик (E). Стирает нарисованное целиком" AutomationProperties.Name="Ластик" />
                </StackPanel>

                <StackPanel x:Name="StyleControls" Orientation="Horizontal">
                    <Border Style="{StaticResource ToolBarDivider}" />
                    <StackPanel x:Name="ColorButtons" Orientation="Horizontal" />
                    <Border Style="{StaticResource ToolBarDivider}" />
                    <Grid Width="28" Height="28" VerticalAlignment="Center" Margin="2,0,6,0">
                        <Ellipse x:Name="SizePreview" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                    </Grid>
                    <Slider x:Name="SizeSlider" Width="120" Minimum="1" Maximum="16" SmallChange="1" LargeChange="2"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,8,0"
                            AutomationProperties.Name="Толщина линии" ToolTip="Толщина" />
                </StackPanel>

                <StackPanel x:Name="CropButtons" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <Border Style="{StaticResource ToolBarDivider}" />
                    <Button Content="Сбросить" Margin="0,0,8,0" Click="OnCropReset" AutomationProperties.Name="Сбросить обрезку" />
                    <Button Content="Отмена" Margin="0,0,8,0" Click="OnCropCancel" AutomationProperties.Name="Отменить обрезку" />
                    <Button Content="Применить" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,4,0" Click="OnCropApply"
                            AutomationProperties.Name="Применить обрезку" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
